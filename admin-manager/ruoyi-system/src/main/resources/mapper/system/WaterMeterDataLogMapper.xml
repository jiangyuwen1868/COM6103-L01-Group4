<mapper namespace="com.ruoyi.system.mapper.WaterMeterDataLogMapper">
    
    <resultMap type="WaterMeterDataLog" id="WaterMeterDataLogResult">
        <result property="id"    column="id"    />
        <result property="deviceSn"    column="device_sn"    />
        <result property="dataType"    column="data_type"    />
        <result property="dataValue"    column="data_value"    />
        <result property="dataUnit"    column="data_unit"    />
        <result property="dataTime"    column="data_time"    />
        <result property="uploadTime"    column="upload_time"    />
        <result property="instructionContent"    column="instruction_content"    />
        <result property="instructionStatus"    column="instruction_status"    />
        <result property="signalStrength"    column="signal_strength"    />
        <result property="batteryLevel"    column="battery_level"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
