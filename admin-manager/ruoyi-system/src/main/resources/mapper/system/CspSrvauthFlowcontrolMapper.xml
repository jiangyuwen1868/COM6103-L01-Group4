<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.CspSrvauthFlowcontrolMapper">
    
    <resultMap type="CspSrvauthFlowcontrol" id="CspSrvauthFlowcontrolResult">
        <result property="id"    column="id"    />
        <result property="pid"    column="pid"    />
        <result property="name"    column="name"    />
    </resultMap>

    <sql id="selectCspSrvauthFlowcontrolVo">
        select id, pid, name from csp_srvauth_flowcontrol
    </sql>

    <select id="selectCspSrvauthFlowcontrolList" parameterType="CspSrvauthFlowcontrol" resultMap="CspSrvauthFlowcontrolResult">
        <include refid="selectCspSrvauthFlowcontrolVo"/>
        <where>  
            <if test="pid != null "> and pid = #{pid}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
        </where>
    </select>
    
    <select id="selectCspSrvauthFlowcontrolById" parameterType="Long" resultMap="CspSrvauthFlowcontrolResult">
        <include refid="selectCspSrvauthFlowcontrolVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertCspSrvauthFlowcontrol" parameterType="CspSrvauthFlowcontrol" useGeneratedKeys="true" keyProperty="id">
        insert into csp_srvauth_flowcontrol
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="pid != null">pid,</if>
            <if test="name != null">name,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="pid != null">#{pid},</if>
            <if test="name != null">#{name},</if>
         </trim>
    </insert>

    <update id="updateCspSrvauthFlowcontrol" parameterType="CspSrvauthFlowcontrol">
        update csp_srvauth_flowcontrol
        <trim prefix="SET" suffixOverrides=",">
            <if test="pid != null">pid = #{pid},</if>
            <if test="name != null">name = #{name},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCspSrvauthFlowcontrolById" parameterType="Long">
        delete from csp_srvauth_flowcontrol where id = #{id}
    </delete>

    <delete id="deleteCspSrvauthFlowcontrolByIds" parameterType="String">
        delete from csp_srvauth_flowcontrol where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>